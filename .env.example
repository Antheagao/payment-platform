# Copy to .env (gitignored) before `docker compose up`. Local-only values for local-only containers.
# SQL Server requires 8+ characters from three of: upper case, lower case, digits, symbols.
# Avoid ; ' and " so the values stay valid inside connection strings and sqlcmd.

# The SQL Server administrator, used only by the one-shot database bootstrap.
MSSQL_SA_PASSWORD=LocalOnly_Admin_2026!

# The application login (payments_app) the API and worker connect as.
PAYMENTS_DB_PASSWORD=LocalOnly_App_2026!
