# Optional. `docker compose up --build` needs no .env: every value below has a default in
# docker-compose.yml. Copy this file to .env (gitignored) and uncomment a line only to change it.

# Host ports, all bound to 127.0.0.1. Move one if something else on the machine already uses it.
# DASHBOARD_PORT=3080
# API_PORT=5080
# WORKER_PORT=5081
# SQL_PORT=14333
# ASPIRE_DASHBOARD_PORT=18888
# OTLP_PORT=4317
# WEBHOOK_RECEIVER_PORT=8090

# Local-only database passwords. SQL Server requires 8+ characters from three of: upper case,
# lower case, digits, symbols. Avoid ; ' and " so the values stay valid in connection strings.
# The sa password applies only when the sqlserver-data volume is created (`docker compose down -v`
# resets it); the application password applies on every start.
# MSSQL_SA_PASSWORD=LocalOnly_Admin_2026!
# PAYMENTS_DB_PASSWORD=LocalOnly_App_2026!

# The key the API signs access tokens with: base64, at least 32 random bytes, for example from
# `openssl rand -base64 32`. Unset, the API makes one at startup (Development only) and logins end
# when it restarts. Never reuse a local key anywhere else; Azure reads it from Key Vault.
# JWT_SIGNING_KEY=

# The dashboard's key for the API (ADR 010): with it, the dashboard names each person's address on
# sign-in, so the per-address login limit is per person. At least 32 characters; both services read
# the same value. Azure reads it from Key Vault.
# DASHBOARD_KEY=LocalOnly_Dashboard_Key_2026_0123456789
